{
  "name": "wagonwise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "arch": "turbo run arch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker/compose.yml up -d --wait postgres",
    "db:down": "docker compose -f infra/docker/compose.yml down",
    "db:migrate": "pnpm --filter @wagonwise/core run db:migrate",
    "db:reset": "pnpm run db:down && pnpm run db:up && pnpm run db:migrate"
  },
  "devDependencies": {
    "@wagonwise/config": "workspace:*",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  }
}
