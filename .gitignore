node_modules/
# ...except the stub packages the architecture fixtures resolve against. Without these
# committed, a fresh clone would see the npm-import fixtures as unresolvable instead.
!packages/architecture/fixtures/**/node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

.env
.env.*
!.env.example

*.log
npm-debug.log*
pnpm-debug.log*

.DS_Store
Thumbs.db

.idea/
.vscode/*
!.vscode/extensions.json

# Valhalla tiles and OSM extracts are large build artefacts, never committed
infra/docker/valhalla_tiles/
infra/docker/*.osm.pbf
