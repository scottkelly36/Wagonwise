# Copy to .env and edit — .env is gitignored, this file is the template.
# Expo CLI loads .env automatically; EXPO_PUBLIC_-prefixed vars are inlined into the
# bundle at build time (see https://docs.expo.dev/guides/environment-variables/).

# src/config.ts already picks the right default with no .env at all: 10.0.2.2 on the
# Android emulator (its alias for the host's own localhost), plain localhost on the iOS
# simulator (which shares the host's network). Only needed to point at a real deployed
# BFF, or at the host machine's LAN IP when testing on a physical device over Wi-Fi.
# EXPO_PUBLIC_BFF_URL=http://192.168.1.50:3002

# Unset means the map screen falls back to MapLibre's own free, keyless demo style
# (src/lib/map-style.ts) — a real map with no signup needed for local dev. Get a free key at
# https://cloud.maptiler.com (Phase 1 testers need a real key; the demo style is dev-only).
# EXPO_PUBLIC_MAPTILER_API_KEY=
