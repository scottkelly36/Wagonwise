# Copy to .env and edit — .env is gitignored, this file is the template.
# Every variable already has a safe local default (config.ts), so .env is only needed to
# override one: a different local Postgres password, a remote database, a non-default port.

# NODE_ENV=development
# HOST=127.0.0.1
# PORT=3001
# LOG_LEVEL=info

# Matches infra/docker/compose.yml's postgres service by default — only needed to point at a
# different database.
# DATABASE_URL=postgres://wagonwise:wagonwise@127.0.0.1:5432/wagonwise

# Unset means identity signs access tokens with a fresh Ed25519 key generated at boot — fine for
# local dev (every restart just invalidates existing sessions), never for anything meant to stay
# up. PEM-encoded, PKCS8, Ed25519 only. Generate one with:
#   node -e "const{generateKeyPairSync:g}=require('crypto');console.log(g('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
# IDENTITY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
