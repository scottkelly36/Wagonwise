# Copy to .env and edit — .env is gitignored, this file is the template.
# Every variable already has a safe local default (config.ts), so .env is only needed to
# override one: a different local Postgres password, a remote database, a non-default port.

# NODE_ENV=development
# HOST=127.0.0.1
# PORT=3001
# LOG_LEVEL=info

# Matches infra/docker/compose.yml's postgres service by default — only needed to point at a
# different database.
# DATABASE_URL=postgres://wagonwise:wagonwise@127.0.0.1:5432/wagonwise

# Unset means identity signs access tokens with a fresh Ed25519 key generated at boot — fine for
# local dev (every restart just invalidates existing sessions), never for anything meant to stay
# up. PEM-encoded, PKCS8, Ed25519 only. Generate one with:
#   node -e "const{generateKeyPairSync:g}=require('crypto');console.log(g('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
# IDENTITY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Every request except /health must send one of these, comma-separated, in X-Internal-Key
# (core is not publicly exposed — decision 11). Defaults to a well-known local-dev value so
# `pnpm dev` plus a plain curl -H "X-Internal-Key: local-dev-internal-key" still works with zero
# configuration. Two keys at once let a key rotate without downtime.
# INTERNAL_KEYS=local-dev-internal-key

# Matches infra/docker/compose.yml's valhalla service's published port by default — only needed
# to point at a different Valhalla instance. Bring the local one up with:
#   docker compose -f infra/docker/compose.yml --profile valhalla up -d valhalla
# VALHALLA_URL=http://127.0.0.1:8002

# Unset works fine — Expo's push API doesn't require an access token by default (M6.5). Only
# needed if a project turns on Expo's "enhanced push security" setting, which then requires every
# push request to carry one.
# EXPO_ACCESS_TOKEN=

# Unlike EXPO_ACCESS_TOKEN, this one is genuinely required for real voice-report parsing (M7.1).
# Unset means every voice transcript is parsed by NullHazardParser instead of a real LLM call —
# always `type: 'other'`, the raw transcript as the note — so `pnpm dev` still works with zero
# configuration. Get a key from https://console.anthropic.com/ to parse for real.
# ANTHROPIC_API_KEY=

# OTP delivery has two independent channels, picked per identifier (phone vs email) by
# ChannelRoutingOtpSender — either can be configured without the other, and an unconfigured
# channel just falls back to ConsoleOtpSender (logs the code, never sends it).

# Phone identifiers. Both unset falls back to console. Get an account/API key at
# https://clicksend.com — CLICKSEND_USERNAME is the account email.
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=

# Email identifiers. Unset falls back to console. Get an API key at https://resend.com — unset
# RESEND_FROM_EMAIL uses Resend's own sandbox sender (only delivers to the account owner's own
# address until a real sending domain is verified with Resend).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# How often the in-process outbox poller (platform/outbox-dispatcher.ts) checks outbox.events
# for pending domain events. Defaults to 2000ms — only needed to slow it down (less DB load) or
# speed it up (faster alerts) for a specific environment.
# OUTBOX_POLL_INTERVAL_MS=2000

# Housekeeping timers inside core (platform/periodic-task.ts). Hazard expiry runs every 5 minutes;
# driver positions (personal data) older than 30 days are deleted, checked hourly. All optional.
# HAZARD_EXPIRY_INTERVAL_MS=300000
# POSITION_SWEEP_INTERVAL_MS=3600000
# JOB_POSITION_RETENTION_DAYS=30
# Planned routes hold where a driver set off from, so they are deleted after this many days too.
# ROUTE_RETENTION_DAYS=30
